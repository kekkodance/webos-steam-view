diff --git a/src/platforms/ihs_udp_sdl.c b/src/platforms/ihs_udp_sdl.c
index 15e0589..9bf3c1a 100644
--- a/src/platforms/ihs_udp_sdl.c
+++ b/src/platforms/ihs_udp_sdl.c
@@ -29,6 +29,13 @@
 #include <SDL_net.h>
 
 #include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+/* winsock2 first: iphlpapi needs its types. */
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <iphlpapi.h>
+#endif
 /* Discovery replies can exceed 2048 bytes (hostname, app lists); Steam's
  * own packet size ceiling is 64KB. A too-small SDL_net packet silently drops
  * the whole datagram, which looks like 'no host answers'. */
@@ -155,3 +162,61 @@ bool IHS_UDPSocketSetRecvTimeout(IHS_UDPSocket *s, uint32_t timeoutUs) {
     (void) s; (void) timeoutUs;
     return true;
 }
+
+#ifdef _WIN32
+/* Directed broadcasts via GetAdaptersAddresses: the SDL backend has no
+ * interface enumeration of its own, so ask WinSock directly. Skips the
+ * VPN/tunnel interfaces (their broadcasts go nowhere useful) the same
+ * way the POSIX side skips non-broadcast interfaces. */
+size_t IHS_UDPBroadcastAddresses(IHS_IPAddress *out, size_t max) {
+    size_t n = 0;
+    ULONG bufLen = 16 * 1024;
+    IP_ADAPTER_ADDRESSES *addrs = (IP_ADAPTER_ADDRESSES *) malloc(bufLen);
+    if (addrs == NULL) return 0;
+    /* Retry once on buffer overflow; anything else means give up. */
+    DWORD rc = GetAdaptersAddresses(AF_INET,
+                                    GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER, NULL, addrs, &bufLen);
+    if (rc == ERROR_BUFFER_OVERFLOW) {
+        free(addrs);
+        addrs = (IP_ADAPTER_ADDRESSES *) malloc(bufLen);
+        if (addrs == NULL) return 0;
+        rc = GetAdaptersAddresses(AF_INET,
+                                  GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER, NULL, addrs, &bufLen);
+    }
+    if (rc == NO_ERROR) {
+        for (IP_ADAPTER_ADDRESSES *a = addrs; a != NULL && n < max; a = a->Next) {
+            if (a->OperStatus != IfOperStatusUp) continue;
+            if (a->IfType == IF_TYPE_SOFTWARE_LOOPBACK) continue;
+            if (a->IfType == IF_TYPE_TUNNEL) continue;
+            for (IP_ADAPTER_UNICAST_ADDRESS *u = a->FirstUnicastAddress; u != NULL && n < max;
+                 u = u->Next) {
+                struct sockaddr_in *sin = (struct sockaddr_in *) u->Address.lpSockaddr;
+                if (u->Address.lpSockaddr->sa_family != AF_INET) continue;
+                uint32_t mask;
+                if (u->OnLinkPrefixLength >= 32 || u->OnLinkPrefixLength == 0) continue;
+                /* Host-order arithmetic, then back to network order for the wire. */
+                uint32_t ip = _byteswap_ulong(sin->sin_addr.s_addr);
+                mask = 0xFFFFFFFFu << (32 - u->OnLinkPrefixLength);
+                uint32_t bcast = _byteswap_ulong(ip | ~mask);
+                if (bcast == 0 || bcast == 0xFFFFFFFFu) continue;
+                bool dup = false;
+                for (size_t i = 0; i < n; i++) {
+                    if (memcmp(out[i].v4.data, &bcast, 4) == 0) { dup = true; break; }
+                }
+                if (dup) continue;
+                out[n].v4.family = IHS_IPAddressFamilyIPv4;
+                memcpy(out[n].v4.data, &bcast, 4);
+                n++;
+            }
+        }
+    }
+    free(addrs);
+    return n;
+}
+#else
+size_t IHS_UDPBroadcastAddresses(IHS_IPAddress *out, size_t max) {
+    (void) out;
+    (void) max;
+    return 0;
+}
+#endif

 bool IHS_ClientAuthorizationRequest(IHS_Client *client, const IHS_HostInfo *host, const char *pin) {
     if (client->taskHandles.authorization) {
         return false;
     }
-    IHS_AuthorizationState *state = malloc(sizeof(IHS_AuthorizationState));

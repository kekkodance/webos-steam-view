-IHS_UDPSocket *IHS_UDPSocketOpen() {
+/* Discovery replies can exceed 2048 bytes (hostname, app lists); Steam's
+ * own packet size ceiling is 64KB. A too-small SDL_net packet silently drops
+ * the whole datagram, which looks like "no host answers". */
+#define UDP_RECV_PACKET_SIZE 65535
+
+IHS_UDPSocket *IHS_UDPSocketOpen(bool broadcast) {
+    (void) broadcast;
+    /* SDL_net needs explicit init on Windows (WSA); nop elsewhere. */
+    if (SDLNet_Init() != 0) {
+        return NULL;
+    }
     IHS_UDPSocket *socket = SDL_malloc(sizeof(IHS_UDPSocket));
     SDL_zerop(socket);
     socket->sockets = SDLNet_AllocSocketSet(2);
-    socket->packet = SDLNet_AllocPacket(2048);
+    socket->packet = SDLNet_AllocPacket(UDP_RECV_PACKET_SIZE);
     socket->socket = SDLNet_UDP_Open(0);
 
     socket->interrupt_port = 53000;
@@ -98,13 +112,13 @@ int IHS_UDPSocketReceive(IHS_UDPSocket *socket, IHS_UDPPacket *packet, int timeo
     return ret;
 }
 
-int IHS_UDPSocketSend(IHS_UDPSocket *socket, IHS_UDPPacket *packet) {
+bool IHS_UDPSocketSend(IHS_UDPSocket *socket, const IHS_UDPPacket *packet) {
     UDPpacket sdlPacket;
     SDL_memset(&sdlPacket, 0, sizeof(UDPpacket));
     AddressToSDL(&packet->address, &sdlPacket.address);
     sdlPacket.data = IHS_BufferPointer(&packet->buffer);
     sdlPacket.len = (int) packet->buffer.size;
-    return SDLNet_UDP_Send(socket->socket, -1, &sdlPacket);
+    return SDLNet_UDP_Send(socket->socket, -1, &sdlPacket) == 1;
 }
 

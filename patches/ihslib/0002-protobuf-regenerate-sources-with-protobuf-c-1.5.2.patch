From d24c3c857c5a88b0314356e2f0b373090d743c98 Mon Sep 17 00:00:00 2001
From: Simone Caronni <negativo17@gmail.com>
Date: Sun, 4 Oct 2026 22:02:23 +0200
Subject: [PATCH 02/11] protobuf: regenerate sources with protobuf-c 1.5.2

No .proto changes. The previous output came from protoc-c 1.3.3 and was
older than remoteplay.proto, so the Neptune messages already defined
there were missing from the generated code.

The generated code needs libprotobuf-c 1.3.0 or newer, which CMake now
checks for.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 CMakeLists.txt                 |   3 +-
 src/protobuf/discovery.pb-c.h  |  80 ++--
 src/protobuf/hiddevices.pb-c.c |  54 ++-
 src/protobuf/hiddevices.pb-c.h | 126 +++----
 src/protobuf/remoteplay.pb-c.c | 462 +++++++++++++++++++++--
 src/protobuf/remoteplay.pb-c.h | 660 +++++++++++++++++++++------------
 6 files changed, 1010 insertions(+), 375 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f2676dd..0cb7beb 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -26,7 +26,8 @@ if (NOT SDL2_FOUND)
 endif ()
 
 if (NOT PROTOBUF_C_FOUND)
-    pkg_check_modules(PROTOBUF_C libprotobuf-c REQUIRED)
+    # The generated sources in src/protobuf need libprotobuf-c 1.3.0 or newer.
+    pkg_check_modules(PROTOBUF_C libprotobuf-c>=1.3.0 REQUIRED)
 endif ()
 
